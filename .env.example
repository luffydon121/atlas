# ATLAS configuration. Copy to .env. Everything is optional: ATLAS runs without any keys.
# .env is git-ignored. Never commit real keys.

# SEC asks automated clients to declare a contact. Put your own name and email here to
# unlock the full EDGAR ticker list (without it, ATLAS uses a built-in large-cap list).
ATLAS_SEC_CONTACT=

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html. Adds the FRED series.
ATLAS_FRED_API_KEY=

# Free key from https://www.bls.gov/developers/. Raises the BLS daily query allowance.
ATLAS_BLS_API_KEY=

# Local AI. Install Ollama, then `ollama pull llama3.2` (or any model you prefer) and set the name below.
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
ATLAS_OLLAMA_MODEL=
# Optional embedding model for semantic document search, such as nomic-embed-text.
ATLAS_OLLAMA_EMBED_MODEL=

# Storage
ATLAS_DATA_DIR=../data

# Background refresh and alert evaluation
ATLAS_SCHEDULER_ENABLED=true
ATLAS_ALERT_INTERVAL_SECONDS=300
# Show macOS notifications when alerts fire
ATLAS_MACOS_NOTIFICATIONS=false

# Passcode for ./scripts/start.sh --lan. Leave empty to get a new random one each start.
ATLAS_PASSCODE=
